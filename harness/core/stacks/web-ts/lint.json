{
  "schema": 1,
  "rules": [
    "harness/no-explicit-any",
    "harness/no-ts-suppress",
    "harness/no-focused-tests",
    "harness/no-skipped-tests",
    "harness/no-empty-catch",
    "harness/no-debugger"
  ],
  "ignore": [
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.min.js",
    "**/*.d.ts",
    "**/*.d.mts",
    "**/*.d.cts",
    "harness/core/**"
  ]
}
