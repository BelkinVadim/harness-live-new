#!/bin/sh
# Единая проверка проекта перед готовностью работы: lint, типы, структурные тесты, тесты, e2e.
# Файл принадлежит harness-kit и заменяется при harness-kit upgrade: не правьте его руками.
# Что запускается — verify.commands в harness.config.yaml; режим каждой проверки (observe,
# ratchet, gate) задаёт уровень зрелости или checks.<имя>.mode там же.
# После harness-kit detach файл принадлежит проекту, а проверки и их режимы — в
# scripts/verify.config.
# Флаги: --check <имя>, --fail-fast, --json, --dry-run.

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec node "$root/harness/core/runtime.mjs" verify --root "$root" "$@"
